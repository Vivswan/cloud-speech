{
  "name": "@cloud-speech/extension",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build:chrome": "wxt zip",
    "build:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun run test:chrome && bun run test:firefox",
    "test:chrome": "vitest run",
    "test:firefox": "WXT_TEST_BROWSER=firefox vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "playwright test --config playwright.firefox.config.ts"
  },
  "author": "Vivswan Shah",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1103.0",
    "@cloud-speech/constants": "workspace:*",
    "@cloud-speech/ui-tokens": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "he": "^1.2.0",
    "htmlparser2": "^12.0.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.34.0",
    "p-retry": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.13.0",
    "sanitize-html": "^2.17.2",
    "tailwind-merge": "^3.4.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/he": "^1.2.3",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@types/selenium-webdriver": "^4.35.6",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.18",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/i18n": "^0.2.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "fast-check": "^4.9.0",
    "happy-dom": "^20.11.0",
    "selenium-webdriver": "^4.48.0",
    "tailwindcss": "~4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4",
    "yaml": "^2.9.0"
  }
}
