{
  "name": "@cloud-speech/extension",
  "version": "2.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv3",
    "build:chrome": "wxt zip",
    "build:firefox": "wxt zip -b firefox --mv3",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:chrome && bun run test:firefox",
    "test:chrome": "vitest run",
    "test:firefox": "WXT_TEST_BROWSER=firefox vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "wxt prepare",
    "test:e2e": "playwright test",
    "test:e2e:firefox": "playwright test --config playwright.firefox.config.ts",
    "screenshots:store": "bun run build:chrome && playwright test --config playwright.screenshots.config.ts"
  },
  "author": "Vivswan Shah",
  "license": "SEE LICENSE IN LICENSE.md",
  "dependencies": {
    "@aws-sdk/client-polly": "^3.1168.0",
    "@cloud-speech/constants": "workspace:*",
    "@cloud-speech/ui-tokens": "workspace:*",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dequal": "^2.0.3",
    "fuse.js": "^7.1.0",
    "he": "^2.0.0",
    "htmlparser2": "^12.0.0",
    "idb-keyval": "^6.3.0",
    "lucide-react": "^1.72.0",
    "p-memoize": "^9.0.0",
    "p-retry": "^9.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "sanitize-html": "^2.18.2",
    "tailwind-merge": "^3.7.0",
    "uint8array-extras": "^1.6.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloud-speech/store-screenshots": "workspace:*",
    "@playwright/test": "^1.65.0",
    "@rgrove/parse-xml": "^5.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/he": "^1.2.3",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "@types/selenium-webdriver": "^4.35.7",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^5.1.0",
    "@wxt-dev/auto-icons": "^1.1.0",
    "@wxt-dev/i18n": "^0.2.8",
    "adm-zip": "^0.6.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "escape-string-regexp": "^5.0.0",
    "fast-check": "^4.10.2",
    "happy-dom": "^21.0.4",
    "selenium-webdriver": "^4.52.0",
    "sharp": "^0.35.5",
    "tailwindcss": "~4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5",
    "yaml": "^2.9.0"
  }
}
