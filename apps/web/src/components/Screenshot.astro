---
import { localeInfo } from "../i18n/locales";
import { t } from "../i18n/ui";
import {
  FULL_SIZE,
  hasLocalRender,
  type ScreenshotScene,
  STORE_SIZE,
  sceneSources,
  storeScreenshotsBase,
} from "../lib/screenshot-source";

// The frame shows the store file (the exact crop the listing gets); click or Enter opens the whole composition
// in a native <dialog>. A file the page's set lacks loads from the English set (lib/screenshot-source.ts).

interface Props {
  scene: ScreenshotScene;
  alt: string;
  class?: string;
}

const { scene, alt, class: className } = Astro.props;
const locale = localeInfo(Astro.currentLocale);
const base = storeScreenshotsBase({
  dev: import.meta.env.DEV,
  rendered: hasLocalRender(locale.storeLocale),
  base: import.meta.env.BASE_URL,
});
const { primary, fallback } = sceneSources(base, locale.storeLocale, scene);
const viewFull = t(locale.code, "screenshot_view_full");
---

<figure class:list={["shot", className]} data-screenshot>
  <button
    type="button"
    class="shot-frame"
    aria-haspopup="dialog"
    aria-label={`${viewFull}: ${alt}`}
    data-screenshot-open
  >
    {/* Hidden until loaded, so no browser draws its broken-image icon or alt text over .shot-missing.
        onload is an attribute so it is attached at parse time, before any load event can fire. */}
    <span class="shot-missing" aria-hidden="true">{alt}</span>
    <img
      class="shot-image"
      src={primary.store}
      data-fallback={fallback.store}
      alt={alt}
      width={STORE_SIZE.width}
      height={STORE_SIZE.height}
      loading="lazy"
      decoding="async"
      onload="this.dataset.loaded = ''"
    />
    <span class="shot-hint" aria-hidden="true">
      <svg
        class="h-3.5 w-3.5"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        viewBox="0 0 24 24"
      >
        <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"></path>
      </svg>
      {viewFull}
    </span>
  </button>
  <dialog class="shot-dialog" aria-label={alt}>
    <img
      class="shot-full"
      src={primary.full}
      data-fallback={fallback.full}
      alt={alt}
      width={FULL_SIZE.width}
      height={FULL_SIZE.height}
      loading="lazy"
      decoding="async"
    />
    <div class="shot-bar">
      <p class="shot-bar-caption text-sm text-stone-300">{alt}</p>
      <a class="shot-bar-link" href={primary.full}>
        {t(locale.code, "screenshot_open_image")}
        <svg
          aria-hidden="true"
          class="h-3.5 w-3.5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          viewBox="0 0 24 24"
        >
          <path d="M7 17 17 7M8 7h9v9"></path>
        </svg>
      </a>
      <button type="button" class="shot-bar-button" data-screenshot-close>
        {t(locale.code, "screenshot_close")}
      </button>
    </div>
  </dialog>
</figure>

<style>
  .shot-frame {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1280 / 800;
    overflow: hidden;
    border-radius: 12px;
    background: var(--inset);
    box-shadow: var(--shadow-card);
    cursor: zoom-in;
    text-align: left;
  }

  .shot-missing {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .shot-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    visibility: hidden;
  }

  .shot-image[data-loaded] {
    visibility: visible;
  }

  .shot-hint {
    position: absolute;
    right: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    background: var(--color-ink);
    padding: 0.375rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-paper);
    box-shadow: var(--shadow-lift);
    opacity: 0;
    transition: opacity 150ms ease;
  }

  .shot-frame:hover .shot-hint,
  .shot-frame:focus-visible .shot-hint {
    opacity: 1;
  }

  /* Any touch pointer (a phone, or a laptop with a touchscreen): hovering is not how the frame is found there. */
  @media (any-pointer: coarse) {
    .shot-hint {
      opacity: 1;
    }
  }

  .shot-dialog {
    /* Tailwind's preflight zeroes the dialog's centering margin; restore it. */
    margin: auto;
    width: fit-content;
    /* The toolbar's controls need this much even when a tiny viewport or high zoom narrows the image further. */
    min-width: min(96vw, 24rem);
    max-width: 96vw;
    max-height: 96vh;
    padding: 0;
    border: 0;
    border-radius: 12px;
    background: var(--color-ink);
    color: var(--color-paper);
    box-shadow: var(--shadow-lift);
    overflow: auto;
  }

  .shot-dialog::backdrop {
    background: rgb(28 25 23 / 0.8);
  }

  .shot-full {
    display: block;
    margin: 0 auto;
    width: auto;
    height: auto;
    max-width: 96vw;
    max-height: calc(100vh - 7.5rem);
  }

  /* Zero intrinsic width: the caption must not widen the box past the image. */
  .shot-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    width: 0;
    min-width: 100%;
    padding: 0.75rem 1rem;
  }

  .shot-bar-caption {
    flex: 1 1 14rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .shot-bar-link,
  .shot-bar-button {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.375rem;
    border-radius: 8px;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    transition: background-color 150ms ease;
  }

  .shot-bar-link {
    color: var(--color-paper);
    background: rgb(255 255 255 / 0.1);
  }

  .shot-bar-button {
    color: var(--color-ink);
    background: var(--color-paper);
    cursor: pointer;
  }

  .shot-bar-link:hover {
    background: rgb(255 255 255 / 0.18);
  }

  .shot-bar-button:hover {
    background: rgb(255 255 255 / 0.85);
  }

  /* The dialog is ink in both themes, so its focus ring is paper. */
  .shot-dialog :focus-visible {
    outline-color: var(--color-paper);
  }

  @media (prefers-reduced-motion: no-preference) {
    .shot-dialog[open] {
      animation: shot-open 180ms var(--ease-snap);
    }

    @keyframes shot-open {
      from {
        opacity: 0;
        transform: scale(0.97);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot-hint {
      transition: none;
    }
  }
</style>

<script>
  // An image can have failed before the listener is attached: complete with zero naturalWidth is that state.
  const fallBack = (image: HTMLImageElement, link?: HTMLAnchorElement) => {
    const fallback = image.dataset.fallback;
    if (fallback === undefined) return;
    delete image.dataset.fallback;
    image.src = fallback;
    if (link) link.href = fallback;
  };
  const withFallback = (image: HTMLImageElement | null, link?: HTMLAnchorElement) => {
    if (!image) return;
    image.addEventListener("error", () => fallBack(image, link));
    if (image.complete && image.naturalWidth === 0) fallBack(image, link);
  };

  // A click on the backdrop lands on the dialog element itself; clicks inside land on its content.
  // Escape and focus return are the native dialog's.
  for (const figure of document.querySelectorAll<HTMLElement>("[data-screenshot]")) {
    const dialog = figure.querySelector("dialog");
    const open = figure.querySelector<HTMLButtonElement>("[data-screenshot-open]");
    if (!dialog || !open) continue;
    withFallback(figure.querySelector<HTMLImageElement>(".shot-image"));
    withFallback(
      dialog.querySelector<HTMLImageElement>(".shot-full"),
      dialog.querySelector<HTMLAnchorElement>(".shot-bar-link") ?? undefined,
    );
    open.addEventListener("click", () => dialog.showModal());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    for (const close of dialog.querySelectorAll<HTMLButtonElement>("[data-screenshot-close]")) {
      close.addEventListener("click", () => dialog.close());
    }
  }
</script>
