---
import { localeInfo } from "../i18n/locales";
import { t } from "../i18n/ui";
import { chromeListing, firefoxListing } from "../lib/site";

// The store buttons every install CTA opens with; a pending listing has no URL, so it gets no button.

const locale = localeInfo(Astro.currentLocale);
---

{
  chromeListing.status === "published" && (
    <a class="btn-primary" href={chromeListing.url}>
      {t(locale.code, "install_chrome")}
    </a>
  )
}
{
  firefoxListing.status === "published" && (
    <a class="btn-primary" href={firefoxListing.url}>
      {t(locale.code, "install_firefox")}
    </a>
  )
}
