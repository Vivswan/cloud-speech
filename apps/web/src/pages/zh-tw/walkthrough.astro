---
import OnThisPage from "../../components/OnThisPage.astro";
import Screenshot from "../../components/Screenshot.astro";
import Base from "../../layouts/Base.astro";
import type { ScreenshotScene } from "../../lib/screenshot-crops";
import { chromeListing, firefoxListing } from "../../lib/site";

// The five store screenshots in reading order, each with its alt text. The
// body is authored HTML (labels in <strong>), the same markup the guides use.
const steps: { id: string; scene: ScreenshotScene; title: string; body: string; alt: string }[] = [
  {
    id: "select",
    scene: "01-context-menu",
    title: "選取文字, 按右鍵",
    body: "在網頁上選取任何文字, 按右鍵, 選擇<strong>朗讀</strong>或較快的語速。同一個選單也能把選取的內容存成音訊檔, 或停止正在進行的朗讀。",
    alt: "一個網頁, 其中一段文字被選取, 右鍵選單已開啟。Cloud Speech 子選單列出朗讀、以 1.5 倍速朗讀、以 2 倍速朗讀、下載音訊與停止朗讀。",
  },
  // Slot, before this step: the popup opened while a web page is being read
  // (the mini-player playing the page's selection, the "Use selection"
  // banner). Waits for a scene the renderer does not produce yet.
  {
    id: "voice",
    scene: "02-preferences-voice-picker",
    title: "挑選語音",
    body: "語音選擇器列出您已連接的服務商的所有語音。依名稱搜尋, 依服務商篩選, 按播放試聽範例, 並為想置頂的語音加星。",
    alt: "偏好設定畫面, 語音選擇器已開啟: 搜尋框, 全部、收藏、OpenAI 與 OpenAI 相容的篩選標籤, 以及帶播放按鈕的已加星語音清單。",
  },
  // Slot, before this step: the Voice & prosody card with the picker closed
  // (speed, pitch, volume gain, speaking style). Waits for a scene the
  // renderer does not produce yet.
  {
    id: "connect",
    scene: "03-settings-providers",
    title: "連接服務商",
    body: "設定中每個服務商一張卡片。貼上您的 API 金鑰, 按<strong>儲存並測試</strong>, 卡片就會變成<strong>已連接</strong>並顯示找到的語音數量。欄位下方的連結會開啟該服務商的設定指南。",
    alt: "設定畫面, OpenAI 卡片已展開: 遮蔽顯示的 API 金鑰欄位、設定指南連結、已啟用開關、儲存並測試按鈕與綠色的已連接標記。",
  },
  {
    id: "sandbox",
    scene: "04-sandbox-player",
    title: "在沙盒裡試一段",
    body: "把任何文字貼到沙盒, 按播放。播放器可以暫停、前後跳十五秒、即時調整語速, 並下載這段朗讀。上方一行標明這段文字會送到哪家服務商。",
    alt: "沙盒畫面, 一段文字正在播放: 字元數、文字將傳送至 OpenAI 的提示, 以及帶暫停、跳轉、語速與下載控制項的播放器。",
  },
  // Slot, before this step: the Sync and Backup cards at the bottom of
  // Settings. Waits for a scene the renderer does not produce yet.
  {
    id: "dark",
    scene: "05-preferences-dark",
    title: "淺色或深色",
    body: "彈出視窗預設跟隨系統主題, 也可以在側欄自行選擇。每個畫面, 包括語音選擇器, 都有深色版本。",
    alt: "深色主題下的偏好設定畫面, 語音選擇器已開啟, 側欄的主題切換設為深色。",
  },
];
---

<Base
  title="功能展示 · Cloud Speech"
  description="用五張截圖看 Cloud Speech 瀏覽器擴充功能的樣子: 右鍵選單、語音選擇器、服務商設定、沙盒播放器與深色主題。"
  active="walkthrough"
>
  <main class="relative mx-auto max-w-3xl px-6 py-12">
    <p><a class="link text-sm text-body" href="../">← 首頁</a></p>

    <header class="mt-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">安裝之前先看一看</h1>
      <p class="mt-4 leading-relaxed text-body">
        擴充功能實際發行版本的五張截圖, 每張都裁到重點的部分。點任何一張查看完整畫面, 或直接開啟圖片放大與儲存。
      </p>
      <OnThisPage items={steps.map((step) => ({ href: `#${step.id}`, label: step.title }))} />
    </header>

    <ol class="mt-12 space-y-16">
      {
        steps.map((step, index) => (
          <li id={step.id} class="scroll-mt-24">
            <div class="flex items-start gap-4">
              <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-inverse text-sm font-semibold text-on-inverse">
                {index + 1}
              </span>
              <div class="min-w-0 pt-1">
                <h2 class="text-lg font-semibold">{step.title}</h2>
                <p class="mt-2 text-[15px] leading-relaxed text-body" set:html={step.body} />
              </div>
            </div>
            <Screenshot class="mt-6" scene={step.scene} alt={step.alt} />
          </li>
        ))
      }
    </ol>

    <section class="card mt-16 p-6">
      <h2 class="text-lg font-semibold">準備好試試了嗎?</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">
        安裝擴充功能, 然後照任何一篇設定指南連接一家服務商。多數指南約需 10 分鐘, 有一家服務商就能開始使用。
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        {
          chromeListing.status === "published" && (
            <a class="btn-primary" href={chromeListing.url}>
              加入 Chrome
            </a>
          )
        }
        {
          firefoxListing.status === "published" && (
            <a class="btn-primary" href={firefoxListing.url}>
              加入 Firefox
            </a>
          )
        }
        <a class="btn-secondary" href="../#guides">設定服務商</a>
      </div>
    </section>
  </main>
</Base>
