---
import OnThisPage from "../components/OnThisPage.astro";
import Screenshot from "../components/Screenshot.astro";
import Base from "../layouts/Base.astro";
import type { ScreenshotScene } from "../lib/screenshot-source";
import { chromeListing, firefoxListing } from "../lib/site";

// The store screenshots in reading order, each with its alt text. The
// body is authored HTML (labels in <strong>), the same markup the guides use.
const steps: { id: string; scene: ScreenshotScene; title: string; body: string; alt: string }[] = [
  {
    id: "select",
    scene: "01-context-menu",
    title: "Select text and right-click",
    body: "Highlight anything on a page, right-click it, and choose <strong>Read aloud</strong>, or a faster speed. The same menu saves the selection as an audio file and stops a reading in progress.",
    alt: "A web page with a highlighted paragraph and the right-click menu open. The Cloud Speech submenu lists Read aloud, Read aloud at 1.5x, Read aloud at 2x, Download audio, and Stop reading.",
  },
  {
    id: "listen",
    scene: "06-sandbox-reading-page",
    title: "Listen while you browse",
    body: "The reading starts right away and keeps going while you scroll. Open the popup and the Sandbox shows its player: pause, skip fifteen seconds back or forward, or change speed. A banner offers the text you highlighted, one click from the Sandbox.",
    alt: "The Sandbox view while a page is being read: a Selected on page banner with a Use selection button, the text box, and the player with pause, skip, speed, and download controls.",
  },
  {
    id: "voice",
    scene: "02-preferences-voice-picker",
    title: "Pick a voice",
    body: "The voice picker lists every voice from the providers you connected. Search by name, filter by provider, press play to hear a sample, and star the voices you want in Favorites.",
    alt: "The Preferences view with the voice picker open: a search box, filter chips for All, Favorites, OpenAI, and OpenAI-compatible, and a list of starred voices with play buttons.",
  },
  {
    id: "tune",
    scene: "07-preferences-prosody",
    title: "Tune the voice",
    body: "Below the voice picker, Preferences holds speed, pitch, volume gain, and speaking style, where the voice supports them. Further down: the audio format for reading and for downloads, the theme, and the keyboard shortcuts.",
    alt: "The Preferences view scrolled to its end: Speed, Pitch, and Volume gain sliders, a Speaking style menu, the Audio format menus for Download and Read aloud, the Theme menu, and the Keyboard shortcuts card.",
  },
  {
    id: "connect",
    scene: "03-settings-providers",
    title: "Connect a provider",
    body: "Settings shows one card per provider. Paste your API key, click <strong>Save &amp; test</strong>, and the card turns <strong>Connected</strong> with the number of voices it found. The link under the field opens that provider's setup guide.",
    alt: "The Settings view with the OpenAI card expanded: a masked API key field, a link to the setup guide, an Enabled switch, a Save and test button, and a green Connected badge.",
  },
  {
    id: "error",
    scene: "09-settings-save-test-error",
    title: "When a key does not work",
    body: "If the first <strong>Save &amp; test</strong> fails, the card stays <strong>Not connected</strong>. A plain sentence says what went wrong; the technical detail sits under Details for when you need it. Fix the key and test again.",
    alt: "The Settings view with the OpenAI card expanded after a failed Save and test: a Not connected chip, a plain error sentence with a Details line under it, and the Save and test button.",
  },
  {
    id: "sync",
    scene: "08-settings-sync",
    title: "Sync and back up",
    body: "Turn on sync and your settings follow you to every browser you are signed into. Export writes them to a file, for safekeeping or another machine; Import reads it back. The popup's display language is set here too.",
    alt: "The end of the Settings view: the Sync card with its switch on, the Backup card with Export and Import buttons, and the Display language menu set to Auto.",
  },
  {
    id: "sandbox",
    scene: "04-sandbox-player",
    title: "Try a passage in the Sandbox",
    body: "Paste any text into the Sandbox and press play. The player pauses, skips fifteen seconds back or forward, changes speed live, and downloads the reading. The line above it names the provider the text goes to.",
    alt: "The Sandbox view with a passage playing: a character count, a note that the text is sent to OpenAI, and a player with pause, skip, speed, and download controls.",
  },
  {
    id: "dark",
    scene: "05-preferences-dark",
    title: "Light or dark",
    body: "The popup follows your system theme, or pick one from the sidebar. Every view, the voice picker included, has a dark version.",
    alt: "The Preferences view in the dark theme, with the voice picker open and the sidebar's theme switch set to Dark.",
  },
];
---

<Base
  title="Walkthrough · Cloud Speech"
  description="What the Cloud Speech browser extension looks like, step by step: the right-click menu, the reading in progress, the voice picker, provider settings, sync and backup, the Sandbox player, and the dark theme."
  active="walkthrough"
>
  <main class="relative mx-auto max-w-3xl px-6 py-12">
    <p><a class="link text-sm text-body" href="../">← Home</a></p>

    <header class="mt-8">
      <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">See it before you install</h1>
      <p class="mt-4 leading-relaxed text-body">
        Screenshots of the extension as it ships, one per step, each cropped to the part that matters.
        Click any of them to see the whole picture, or open the image itself to zoom in and save
        it.
      </p>
      <OnThisPage items={steps.map((step) => ({ href: `#${step.id}`, label: step.title }))} />
    </header>

    <ol class="mt-12 space-y-16">
      {
        steps.map((step, index) => (
          <li id={step.id} class="scroll-mt-24">
            <div class="flex items-start gap-4">
              <span class="flex h-8 w-8 flex-none items-center justify-center rounded-full bg-inverse text-sm font-semibold text-on-inverse">
                {index + 1}
              </span>
              <div class="min-w-0 pt-1">
                <h2 class="text-lg font-semibold">{step.title}</h2>
                <p class="mt-2 text-[15px] leading-relaxed text-body" set:html={step.body} />
              </div>
            </div>
            <Screenshot class="mt-6" scene={step.scene} alt={step.alt} />
          </li>
        ))
      }
    </ol>

    <section class="card mt-16 p-6">
      <h2 class="text-lg font-semibold">Ready to try it?</h2>
      <p class="mt-2 text-sm leading-relaxed text-body">
        Install the extension, then follow one setup guide to connect a provider. Most guides take
        about 10 minutes, and one provider is enough to start.
      </p>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        {
          chromeListing.status === "published" && (
            <a class="btn-primary" href={chromeListing.url}>
              Add to Chrome
            </a>
          )
        }
        {
          firefoxListing.status === "published" && (
            <a class="btn-primary" href={firefoxListing.url}>
              Add to Firefox
            </a>
          )
        }
        <a class="btn-secondary" href="../#guides">Set up a provider</a>
      </div>
    </section>
  </main>
</Base>
