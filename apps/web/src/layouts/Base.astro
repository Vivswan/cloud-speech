---
import "@fontsource/ibm-plex-sans/400.css";
import "@fontsource/ibm-plex-sans/500.css";
import "@fontsource/ibm-plex-sans/600.css";
import "@fontsource/ibm-plex-sans/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles.css";
import { LOCALE_TAG_RULES } from "@cloud-speech/constants";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import {
  LOCALES,
  localeInfo,
  localeUrl,
  PREFERRED_LOCALE_STORAGE_KEY,
  stripLocale,
} from "../i18n/locales";
import { t } from "../i18n/ui";
import type { NavPage } from "../lib/site";
import { THEME_COLORS, themeInitScript } from "../scripts/theme";

interface Props {
  title: string;
  description: string;
  active?: NavPage;
  /** 404 only: the one page with no locale variants and no auto-redirect. */
  noLocaleRedirect?: boolean;
}

const { title, description, active, noLocaleRedirect = false } = Astro.props;

const base = import.meta.env.BASE_URL;
const locale = localeInfo(Astro.currentLocale);
const { pagePath } = stripLocale(Astro.url.pathname);

// Authoritative URL for crawlers: includes the GitHub Pages base path, and
// consolidates the .../ vs .../index.html duplicate every directory-format route
// emits. Astro.url.pathname already carries the configured base at build time.
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;

// The /staging/ preview (managed pages.yml exports PAGES_STAGING=1 for that
// build) is a full duplicate of the production site; keep it out of search
// results. robots.txt can't help here (it only works at the origin root,
// which this project page doesn't own), so the meta tag is the mechanism.
const staging = Boolean(process.env.PAGES_STAGING);

// Every page exists in all four locales (404 opts out), so tell crawlers where
// each language lives; x-default points at the unprefixed English tree.
const alternates =
  Astro.site && !noLocaleRedirect
    ? LOCALES.map((l) => ({
        hreflang: l.hreflang,
        href: new URL(localeUrl(l.code, pagePath), Astro.site).href,
      }))
    : [];
const xDefault = Astro.site ? new URL(localeUrl("en", pagePath), Astro.site).href : undefined;
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={THEME_COLORS.light} />
    {/* Theme init, inlined so it runs before first paint (no flash of the
        wrong theme). The logic and values live once in src/scripts/theme.ts
        (shared with site.ts); themeInitScript() serializes them here. */}
    <script is:inline set:html={themeInitScript()} />
    <script
      is:inline
      define:vars={{
        pageLocale: locale.code,
        pagePath,
        base,
        noRedirect: noLocaleRedirect,
        tagRules: LOCALE_TAG_RULES,
        preferredLocaleKey: PREFERRED_LOCALE_STORAGE_KEY,
      }}
    >
      // First-visit language auto-detect: on the ENGLISH tree only, with no
      // stored preference, send the browser to its own language's copy of this
      // page. Storing before navigating makes the redirect one-shot: the
      // stored preference (set here or by the nav switcher) always wins later.
      // The BCP-47 tag rules and the storage key come from their shared
      // modules (constants, i18n/locales) via define:vars above.
      (() => {
        if (noRedirect || pageLocale !== "en") return;
        try {
          if (localStorage.getItem(preferredLocaleKey)) return;
          var languages =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || ""];
          for (var i = 0; i < languages.length; i++) {
            var tag = String(languages[i]).toLowerCase();
            var pick = null;
            for (var j = 0; j < tagRules.length && !pick; j++) {
              if (new RegExp(tagRules[j].pattern).test(tag)) pick = tagRules[j].locale;
            }
            if (!pick) continue;
            // The list is ordered by preference, so an English entry before
            // any match means the visitor prefers English; stop looking.
            if (pick === "en") return;
            localStorage.setItem(preferredLocaleKey, pick);
            location.replace(base + pick + "/" + pagePath);
            return;
          }
        } catch (_error) {
          /* storage denied; stay on English */
        }
      })();
    </script>
    {staging && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {!staging && <link rel="sitemap" href={`${base}sitemap.xml`} />}
    <link rel="icon" type="image/svg+xml" href={`${base}icon.svg`} />
    <title>{title}</title>
  </head>
  <body class="bg-page font-sans text-strong antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-[60] focus:rounded-lg focus:bg-inverse focus:px-3.5 focus:py-1.5 focus:text-on-inverse"
    >
      {t(locale.code, "skip_to_content")}
    </a>
    <Nav active={active} hideLocaleSwitcher={noLocaleRedirect} />
    {/* Skip-link target only; every page supplies its own semantic <main>. */}
    <div id="main">
      <slot />
    </div>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
