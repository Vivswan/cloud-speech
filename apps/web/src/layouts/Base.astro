---
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles.css";
import { LOCALE_TAG_RULES } from "@cloud-speech/constants";
import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import {
  LOCALES,
  localeInfo,
  localeUrl,
  PREFERRED_LOCALE_STORAGE_KEY,
  stripLocale,
} from "../i18n/locales";
import { t } from "../i18n/ui";
import { isIndexableTier } from "../lib/pages-tier";
import type { NavPage } from "../lib/site";
import { THEME_COLORS, themeInitScript } from "../scripts/theme";

interface Props {
  title: string;
  description: string;
  active?: NavPage;
  /** 404 only: GitHub Pages serves it at every missing URL, so it has no
   *  canonical (Astro emits it as 404.html, never as a 404/ route), no locale
   *  variants, and no auto-redirect. */
  notFound?: boolean;
}

const { title, description, active, notFound = false } = Astro.props;

const base = import.meta.env.BASE_URL;
const locale = localeInfo(Astro.currentLocale);
const { pagePath } = stripLocale(Astro.url.pathname);

// Consolidates the .../ and .../index.html duplicate every directory-format route emits.
// Astro.url.pathname already carries the base at build time.
const canonical = Astro.site && !notFound ? new URL(Astro.url.pathname, Astro.site) : undefined;

// Every page is authored in every locale (404 opts out), so each alternate is real; generate-sitemap.mjs
// fails the PR build (checks.yml, an indexable-tier build) on a page missing from any locale tree.
const alternates =
  Astro.site && !notFound
    ? LOCALES.map((l) => ({
        hreflang: l.hreflang,
        href: new URL(localeUrl(l.code, pagePath), Astro.site).href,
      }))
    : [];
const xDefault = Astro.site ? new URL(localeUrl("en", pagePath), Astro.site).href : undefined;
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={THEME_COLORS.light} />
    {/* Inlined so it runs before first paint; scripts/check-theme-init.mjs runs the emitted copy. */}
    <script is:inline set:html={themeInitScript()} />
    <script
      is:inline
      define:vars={{
        pageLocale: locale.code,
        pagePath,
        base,
        noRedirect: notFound,
        tagRules: LOCALE_TAG_RULES,
        preferredLocaleKey: PREFERRED_LOCALE_STORAGE_KEY,
      }}
    >
      // First-visit auto-detect, English tree only. Storing before navigating makes it one-shot: a
      // stored preference (set here or by the nav switcher) always wins later.
      (() => {
        if (noRedirect || pageLocale !== "en") return;
        try {
          if (localStorage.getItem(preferredLocaleKey)) return;
          var languages =
            navigator.languages && navigator.languages.length
              ? navigator.languages
              : [navigator.language || ""];
          for (var i = 0; i < languages.length; i++) {
            var tag = String(languages[i]).toLowerCase();
            var pick = null;
            for (var j = 0; j < tagRules.length && !pick; j++) {
              if (new RegExp(tagRules[j].pattern).test(tag)) pick = tagRules[j].locale;
            }
            if (!pick) continue;
            // navigator.languages is ordered by preference: English before any other match means stay.
            if (pick === "en") return;
            localStorage.setItem(preferredLocaleKey, pick);
            location.replace(base + pick + "/" + pagePath);
            return;
          }
        } catch (_error) {
          /* storage denied; stay on English */
        }
      })();
    </script>
    {/* latest/ and vX.Y.Z/ duplicate the root tier (lib/pages-tier.ts). robots.txt cannot do this: it
        only works at the origin root, which a project page does not own. */}
    {!isIndexableTier && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={xDefault} />}
    {isIndexableTier && <link rel="sitemap" href={`${base}sitemap.xml`} />}
    <link rel="icon" type="image/svg+xml" href={`${base}icon.svg`} />
    <title>{title}</title>
  </head>
  <body class="bg-page font-sans text-strong antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-[60] focus:rounded-lg focus:bg-inverse focus:px-3.5 focus:py-1.5 focus:text-on-inverse"
    >
      {t(locale.code, "skip_to_content")}
    </a>
    <Nav active={active} hideLocaleSwitcher={notFound} />
    {/* Skip-link target only; every page supplies its own semantic <main>. */}
    <div id="main">
      <slot />
    </div>
    <Footer />
    <script src="../scripts/site.ts"></script>
  </body>
</html>
